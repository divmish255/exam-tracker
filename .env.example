# Long random string used to sign OTP challenges and login sessions.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# From https://resend.com (free tier is enough to start)
RESEND_API_KEY=
# Until you verify your own domain in Resend, keep this sender.
# It can only deliver to the email address you signed up to Resend with.
EMAIL_FROM=Exam Board Portal <onboarding@resend.dev>

# Added automatically when you create a Blob store in Vercel (Storage tab) and connect it to the project
BLOB_READ_WRITE_TOKEN=
